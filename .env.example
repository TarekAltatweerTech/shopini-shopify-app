# The app's Client ID from the Shopify Partner Dashboard.
# Public by design — it ships in the bundle and in the page's meta tag.
# The Client SECRET belongs to the Laravel backend and must never appear here.
VITE_SHOPIFY_API_KEY=

# Origin of the Laravel backend, no trailing slash.
# This origin must also be listed in the backend's FRONTEND_URL /
# CORS_ALLOWED_ORIGINS, or every request is blocked by CORS.
VITE_API_BASE_URL=https://api.example.com
